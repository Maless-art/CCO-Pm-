rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function logged() { return request.auth != null; }
  function profile() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
  function active() { return logged() && profile().activo == true; }
  function admin() { return active() && profile().rol == 'administrador'; }
  function consult() { return active() && profile().rol == 'consulta'; }
  function operator() { return active() && profile().rol == 'operador'; }
  function canWrite() { return admin() || operator(); }
  function sees(d) { return active() && (admin() || consult() || (operator() && d.operadorUid == request.auth.uid)); }
  function owns(d) { return canWrite() && (admin() || (operator() && d.operadorUid == request.auth.uid)); }
  function validOwner(d) {
   return d.keys().hasAll(['operadorUid']) &&
    d.operadorUid in ['5OCUloVGtfcKfg1zv2nlmaFWwnu1', 'qn3fdJXRafOuTAdhRIGizFepL1z1'];
  }
  function sameOwner() { return request.resource.data.operadorUid == resource.data.operadorUid; }
  function migrationOnly() {
   return admin() && !resource.data.keys().hasAny(['operadorUid']) &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['operadorUid']) &&
    validOwner(request.resource.data);
  }
  match /usuarios/{userId} {
   allow read: if logged() && request.auth.uid == userId;
   allow write: if false;
  }
  match /clientes/{id} {
   allow read: if sees(resource.data);
   allow create: if canWrite() && validOwner(request.resource.data) && owns(request.resource.data);
   allow update: if (owns(resource.data) && sameOwner()) || migrationOnly();
   allow delete: if false;
  }
  match /facturas/{id} {
   allow read: if sees(resource.data);
   allow create: if canWrite() && validOwner(request.resource.data) && owns(request.resource.data);
   allow update: if (owns(resource.data) && sameOwner() &&
      (admin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'codigo','cliente','ruta','vendedor','contacto','telefono','factura','monto',
        'fechaFactura','entrega','chequePosfechado','fechaCheque','plazo','notas',
        'pagado','estado','actualizadoPor','fechaActualizacion',
        'fechaActualizacionNota','notaActualizadaPor','saldoPendiente',
        'montoPagado','fechaUltimoPago'
      ]) && request.resource.data.get('anulada',false) == resource.data.get('anulada',false)
      && request.resource.data.get('estado','activa') != 'anulada')) || migrationOnly();
   allow delete: if false;
  }
  match /pagos/{id} {
   allow read: if sees(resource.data);
   allow create: if canWrite() && validOwner(request.resource.data) && owns(request.resource.data);
   allow update: if migrationOnly();
   allow delete: if false;
  }
  match /auditoria/{id} {
   allow read: if sees(resource.data);
   allow create: if canWrite() && validOwner(request.resource.data) && owns(request.resource.data);
   allow update: if migrationOnly();
   allow delete: if false;
  }
 }
}
